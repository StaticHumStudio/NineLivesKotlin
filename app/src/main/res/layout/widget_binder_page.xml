                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:gravity="center_horizontal|top"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:lineSpacingMultiplier="0.95"
                            android:lines="2"
                            android:textColor="#FFC4A96A"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/binder_p7_cell"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="@dimen/widget_binder_pocket_gap">

                        <LinearLayout
                            android:id="@+id/binder_p7_box"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/binder_p7_square"
                                    style="@style/NineLivesWidgetSquare" />

                                <ImageView
                                    android:id="@+id/binder_p7_disc"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_alignBottom="@id/binder_p7_square"
                                    android:layout_alignEnd="@id/binder_p7_square"
                                    android:layout_alignStart="@id/binder_p7_square"
                                    android:layout_alignTop="@id/binder_p7_square"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitXY" />

                                <TextView
                                    android:id="@+id/binder_p7_title"
                                    style="@style/NineLivesWidgetSleeveTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_alignBottom="@id/binder_p7_square"
                                    android:layout_alignEnd="@id/binder_p7_square"
                                    android:layout_alignStart="@id/binder_p7_square"
                                    android:layout_alignTop="@id/binder_p7_square"
                                    android:importantForAccessibility="no"
                                    android:shadowColor="#FF0A0520"
                                    android:shadowRadius="4"
                                    android:visibility="gone" />

                                <ImageView
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_alignBottom="@id/binder_p7_square"
                                    android:layout_alignEnd="@id/binder_p7_square"
                                    android:layout_alignStart="@id/binder_p7_square"
                                    android:layout_alignTop="@id/binder_p7_square"
                                    android:importantForAccessibility="no"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/widget_binder_sleeve" />
                            </RelativeLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/binder_p7_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:gravity="center_horizontal|top"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:lineSpacingMultiplier="0.95"
                            android:lines="2"
                            android:textColor="#FFC4A96A"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/binder_footer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_binder_footer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/binder_prev"
                android:layout_width="@dimen/widget_binder_footer_arrow"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_binder_arrow_prev" />
            </FrameLayout>

            <TextView
                android:id="@+id/binder_page_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="#FF8B8B95"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/binder_next"
                android:layout_width="@dimen/widget_binder_footer_arrow"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_binder_arrow_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
