<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: an open Binder with four blank discs in their sleeves,
     the stitched spine, and the page arrows underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_binder_cover"
    android:layoutDirection="ltr"
    android:padding="@dimen/widget_binder_cover_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_binder_page_bg"
        android:orientation="vertical"
        android:padding="@dimen/widget_binder_page_inset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include layout="@layout/widget_binder_preview_pocket" />

            <include layout="@layout/widget_binder_preview_pocket" />

            <FrameLayout
                android:layout_width="@dimen/widget_binder_spine_slot"
                android:layout_height="match_parent"
                android:paddingHorizontal="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_binder_spine" />
            </FrameLayout>

            <include layout="@layout/widget_binder_preview_pocket" />

            <include layout="@layout/widget_binder_preview_pocket" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_binder_footer"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/widget_binder_footer_arrow"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_binder_arrow_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="@dimen/widget_binder_footer_arrow"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_binder_arrow_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
