<?xml version="1.0" encoding="utf-8"?>
<!-- One binder page behind a spread. The board colour with a thin gilt edge, so the
     pages StackView fans out behind the front one read as stacked binder pages. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- archiveVoidSurface, the same as the board, so baked cover corners match -->
    <solid android:color="#FF1A1135" />
    <!-- goldFilamentFaint -->
    <stroke android:width="1dp" android:color="#FF3D3520" />
    <corners android:radius="12dp" />
</shape>
