<?xml version="1.0" encoding="utf-8"?>
<!-- The Binder when it has books: a stack of pages under one fixed spine, on the
     padded cover. A vertical fling turns the page (StackView is the only RemoteViews
     collection that takes a fling), and so do the arrows on every page (BinderTurn.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_binder_cover"
    android:layoutDirection="ltr"
    android:padding="@dimen/widget_binder_cover_padding">

    <StackView
        android:id="@+id/binder_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <!-- Shown while the stack has no items yet: a blank page where the front page sits. -->
    <LinearLayout
        android:id="@+id/binder_stack_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="9"
                android:background="@drawable/widget_binder_page_bg" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- The one fixed spine, drawn over the stack so it never turns with a page.
         StackView sizes every page at 90% of its width and height and draws the front
         page against its left and bottom edges (the pages behind fan up and right), so
         this 1 : 9 by 9 : 1 grid puts the spine in the middle of the front page, in the
         gap each page leaves for it (widget_binder_page.xml). It stops above the page's
         footer when the page has one. StackView never mirrors its fan, so every Binder
         layout is pinned left to right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/binder_spine_frame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="9"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/widget_binder_page_inset">

                <FrameLayout
                    android:layout_width="@dimen/widget_binder_spine_width"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_binder_spine" />

                <FrameLayout
                    android:id="@+id/binder_spine_footer_gap"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_binder_footer"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
