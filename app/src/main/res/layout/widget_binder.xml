<?xml version="1.0" encoding="utf-8"?>
<!-- The Binder when it has books: a stack of pages under one fixed spine, on the
     padded cover. A vertical fling turns the page (StackView is the only RemoteViews
     collection that takes a fling), and so do the arrows on every page (BinderTurn.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_binder_cover"
    android:layoutDirection="ltr"
    android:padding="@dimen/widget_binder_cover_padding">

    <StackView
        android:id="@+id/binder_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <include layout="@layout/widget_binder_overlay" />
</FrameLayout>
