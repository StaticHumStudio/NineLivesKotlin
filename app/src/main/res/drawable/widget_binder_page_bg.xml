<?xml version="1.0" encoding="utf-8"?>
<!-- One binder page. A shade deeper than the cover, with a gilt edge, so the pages
     StackView fans out behind the front one read as a stack of sleeve pages. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- archiveVoidBase. Disc bitmaps bake this colour outside their pocket's corners (BinderDisc.kt). -->
    <solid android:color="#FF110A28" />
    <!-- goldFilamentFaint -->
    <stroke android:width="1dp" android:color="#FF3D3520" />
    <corners android:radius="9dp" />
</shape>
