<?xml version="1.0" encoding="utf-8"?>
<!-- The binder's spine between two sleeves: a dark strip, two gilt rails, three rivets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- archiveVoidElevated -->
            <solid android:color="#FF251945" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:width="1dp" android:gravity="left|fill_vertical" android:left="1dp">
        <shape android:shape="rectangle">
            <!-- goldFilamentFaint -->
            <solid android:color="#FF3D3520" />
        </shape>
    </item>
    <item android:width="1dp" android:gravity="right|fill_vertical" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF3D3520" />
        </shape>
    </item>
    <item android:width="4dp" android:height="4dp" android:gravity="top|center_horizontal" android:top="10dp">
        <shape android:shape="oval">
            <!-- goldFilamentDim -->
            <solid android:color="#FFB89650" />
        </shape>
    </item>
    <item android:width="4dp" android:height="4dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFB89650" />
        </shape>
    </item>
    <item android:width="4dp" android:height="4dp" android:gravity="bottom|center_horizontal" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFB89650" />
        </shape>
    </item>
</layer-list>
