<?xml version="1.0" encoding="utf-8"?>
<!-- The Binder closed: locked, signed out, or empty. The padded cover with its spine
     down the left edge, the eye pressed into the cover, and one calm line.
     Never a book or a cover. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_binder_cover"
    android:layoutDirection="ltr"
    android:padding="@dimen/widget_binder_cover_padding">

    <LinearLayout
        android:id="@+id/binder_message_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/widget_binder_spine_width"
            android:layout_height="match_parent"
            android:background="@drawable/widget_binder_spine" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_binder_emblem">

                <ImageView
                    android:id="@+id/binder_message_eye_square"
                    style="@style/NineLivesWidgetSquare" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_alignBottom="@id/binder_message_eye_square"
                    android:layout_alignEnd="@id/binder_message_eye_square"
                    android:layout_alignStart="@id/binder_message_eye_square"
                    android:layout_alignTop="@id/binder_message_eye_square"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/widget_eye_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_eye" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="8dp"
            android:paddingStart="2dp">

            <ImageView
                android:id="@+id/binder_lock"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_lock"
                android:visibility="gone" />

            <TextView
                android:id="@+id/binder_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="4"
                android:textColor="#FFE0E0E5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
