<?xml version="1.0" encoding="utf-8"?>
<!-- The spine the pages are sewn into: a raised band with a stitch line down each
     side. One dashed rectangle draws both stitch lines. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- archiveVoidElevated -->
            <solid android:color="#FF251945" />
            <!-- goldFilamentFaint -->
            <stroke android:width="1dp" android:color="#FF3D3520" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="3dp" android:right="3dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <!-- goldFilamentDim -->
            <stroke
                android:width="1dp"
                android:color="#B3B89650"
                android:dashGap="2.5dp"
                android:dashWidth="3dp" />
        </shape>
    </item>
</layer-list>
