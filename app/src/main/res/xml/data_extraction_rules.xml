<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (API 31+): Exclude encrypted prefs from cloud backup.
    Auth tokens and server credentials must not leave the device via backup.
    Device-to-device transfer allows non-sensitive prefs but excludes secrets.

    Entitlement prefs go in OPPOSITE directions, on purpose:
    - nine_lives_entitlement.xml (grandfather flag `legacy_paid`) MUST ride
      both cloud backup and device transfer. Cloud backup covers it via
      default-include (no <include> rules present ... adding one flips the
      section to allowlist mode), and device transfer covers it via the
      existing sharedpref include below.
    - nine_lives_entitlement_cache.xml (cached Play grant + the release-build
      force-free test override) IS now excluded from BOTH sections below. A
      backed-up Play grant becomes a portable unlock on accounts that never
      paid, and the revocation condition (a SUCCESSFUL empty query) can never
      fire while Billing is unreachable. device-transfer needs its own explicit
      exclude because the <include domain="sharedpref" path="."/> below would
      otherwise sweep the cache along with everything else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nine_lives_secure_prefs.xml" />
        <exclude domain="sharedpref" path="nine_lives_entitlement_cache.xml" />
        <exclude domain="file" path="NineLivesAudio/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="nine_lives_secure_prefs.xml" />
        <exclude domain="sharedpref" path="nine_lives_entitlement_cache.xml" />
    </device-transfer>
</data-extraction-rules>
